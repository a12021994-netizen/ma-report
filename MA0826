}
.overview-diverge{
  font-size:9.5px; color:var(--signal); background:var(--signal-bg);
  padding:2px 7px; border-radius:20px; white-space:nowrap; flex-shrink:0;
}

.data-source-note{
  font-size:10.5px; color:var(--text-faint); margin-top:6px;
}

@media (max-width:480px){
  body{padding:20px 12px 50px;}
  .overview-name{width:72px; font-size:12px;}
  .overview-pct{width:38px; font-size:11px;}
  .overview-diverge{display:none;}
  .overview-rank{width:16px;}
}
</style>
</head>
<body>
<div class="wrap">

  <div class="hero">
    <div class="eyebrow">Prototype · 均線強弱背離篩選</div>
    <h1>族群 x 大盤 均線強弱分析</h1>
    <p>判斷族群個股是否站上 5/10/20/60/120/240 日均線,並與加權指數、櫃買指數的均線位置比較,找出強於大盤之族群。</p>
    <p class="data-source-note">資料來源: Yahoo Finance (yfinance) · 產生時間: __GENERATED_AT__</p>
  </div>

  <div class="bench-row" id="benchRow"></div>

  <div class="export-bar">
    <span class="export-hint" id="exportHint">按這裡可以把目前畫面上的個股資料複製成一段文字,方便留存或核對。</span>
    <span class="export-status" id="exportStatus"></span>
    <button class="export-btn" id="exportBtn" type="button">複製全部資料</button>
  </div>

  <div id="overviewRoot"></div>

  <div id="groupsRoot"></div>

  <div class="legend">
    <span><i class="above"></i>站上均線</span>
    <span><i class="below"></i>跌破均線</span>
    <span><i class="signal"></i>族群多數站上,但大盤已跌破 → 背離訊號</span>
  </div>

</div>

<script>
const MA_PERIODS = [5,10,20,60,120,240];

const benchmarks = __BENCHMARKS_JSON__;

const groups = __GROUPS_JSON__;

// ---------- 計算邏輯 ----------
function isAbove(close, ma){
  if(!isFinite(close) || !isFinite(ma) || close<=0 || ma<=0) return null;
  return close > ma;
}
function countAbove(close, maMap){
  let n=0, total=0;
  MA_PERIODS.forEach(p=>{
    const r = isAbove(close, maMap[p]);
    if(r!==null){ total++; if(r) n++; }
  });
  return {n, total};
}

// ---------- 大盤基準渲染 ----------
function renderBenchmarks(){
  const root = document.getElementById('benchRow');
  root.innerHTML = benchmarks.map(b=>{
    const dots = MA_PERIODS.map(p=>{
      const above = isAbove(b.close, b.ma[p]);
      const maVal = (b.ma[p]===null || b.ma[p]===undefined) ? null : b.ma[p];
      return `<div class="dot-wrap">
        <div class="dot-label">MA${p}</div>
        <div class="dot ${above?'above':above===false?'below':''}">
          <div class="dot-arrow">${above===null?'–':(above? '▲':'▼')}</div>
          <div class="dot-val">${maVal===null?'–':maVal.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}</div>
        </div>
      </div>`;
    }).join('');
    const cnt = countAbove(b.close, b.ma);
    return `<div class="bench-card">
      <div class="bench-top">
        <div class="bench-name">${b.name}</div>
        <a class="chart-link" href="${b.chartUrl}" target="_blank" rel="noopener">K線圖 ↗</a>
      </div>
      <div class="bench-date-row">${b.date}</div>
      <div class="bench-price">${b.close===null?'–':b.close.toLocaleString()}<span class="sub">站上 ${cnt.n}/${cnt.total} 條均線</span></div>
      <div class="ladder">${dots}</div>
    </div>`;
  }).join('');
}

const state = {};
groups.forEach(g=> g.stocks.forEach(s=>{
  state[s.code] = {
    close: s.close ?? '', high: s.high ?? '',
    ma5: s.ma5 ?? '', ma10: s.ma10 ?? '', ma20: s.ma20 ?? '', ma60: s.ma60 ?? '',
    ma120: s.ma120 ?? '', ma240: s.ma240 ?? '', high52w: s.high52w ?? ''
  };
}));

function num(v){
  const n = parseFloat(v);
  return isFinite(n) ? n : NaN;
}

function computeRow(code){
  const d = state[code];
  const close = num(d.close);
  const maMap = {5:num(d.ma5),10:num(d.ma10),20:num(d.ma20),60:num(d.ma60),120:num(d.ma120),240:num(d.ma240)};
  const cnt = countAbove(close, maMap);
  return {close, maMap, cnt};
}

function displayCell(value, opts={}){
  const cls = ['data-cell'];
  if(opts.above===true) cls.push('above');
  if(opts.above===false) cls.push('below');
  const v = (value===''||value===undefined||value===null) ? '–' : value;
  return `<div class="${cls.join(' ')}">${v}</div>`;
}

function renderGroups(){
  const root = document.getElementById('groupsRoot');
  root.innerHTML = groups.map(g=>{
    const rows = g.stocks.map(s=>{
      const r = computeRow(s.code);
      const cntColor = r.cnt.total===0 ? 'var(--text-faint)' : (r.cnt.n>=4?'var(--strong)': r.cnt.n<=2?'var(--weak)':'var(--signal)');
      const chartUrl = `https://www.wantgoo.com/stock/${s.code}/technical-chart`;
      return `<tr>
        <td class="left code">${s.code}</td>
        <td class="left name"><a class="stock-link" href="${chartUrl}" target="_blank" rel="noopener" title="開啟 ${s.name} K線圖">${s.name}</a></td>
        <td>
          ${displayCell(state[s.code].close)}
          <div class="date-tag">${s.date||''}</div>
        </td>
        <td>${displayCell(state[s.code].high)}</td>
        ${MA_PERIODS.map(p=>`<td>${displayCell(state[s.code]['ma'+p],{above:isAbove(r.close,r.maMap[p])})}</td>`).join('')}
        <td><span class="count-badge" style="color:${cntColor}">${r.cnt.total? r.cnt.n+'/'+r.cnt.total : '–'}</span></td>
      </tr>`;
    }).join('');

    return `<div class="group-card" id="grp-${g.name}" data-group="${g.name}">
      <div class="group-head">
        <h2>${g.name}</h2>
        <div class="count">${g.stocks.length} 檔成分股</div>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th class="left col-code">代號</th><th class="left col-name">名稱</th>
              <th class="col-num">收盤價</th><th class="col-num">盤中<br/>最高</th>
              ${MA_PERIODS.map(p=>`<th class="col-num">MA${p}</th>`).join('')}
              <th class="col-cnt">站上<br/>均線數</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
      <div class="group-summary" data-summary="${g.name}"></div>
    </div>`;
  }).join('');

  renderSummaries();
}

function renderSummaries(){
  groups.forEach(g=>{
    const el = document.querySelector(`[data-summary="${g.name}"]`);
    const cells = MA_PERIODS.map(p=>{
      let above=0, total=0;
      g.stocks.forEach(s=>{
        const close = num(state[s.code].close);
        const ma = num(state[s.code]['ma'+p]);
        const r = isAbove(close, ma);
        if(r!==null){ total++; if(r) above++; }
      });
      const pct = total? Math.round(above/total*100) : null;
      const benchBelow = benchmarks.filter(b=> isAbove(b.close,b.ma[p])===false).map(b=>b.name.split(' ')[0]);
      const diverge = pct!==null && pct>=70 && benchBelow.length>0;
      return `<div class="summary-cell ${diverge?'diverge':''}">
        <div class="period">MA${p}</div>
        <div class="pct" style="color:${pct===null?'var(--text-faint)': diverge?'var(--signal)':(pct>=70?'var(--strong)':pct<=30?'var(--weak)':'var(--text)')}">${pct===null?'–':pct+'%'}</div>
        <div class="count-sub">${total? above+'/'+total+' 家' : ''}</div>
        <div class="flag">${diverge? '族群強於 '+benchBelow.join('/') : ''}</div>
      </div>`;
    }).join('');
    el.innerHTML = `<div class="summary-title">族群站上各均線比例(%)　—　與大盤同期均線位置比對</div>
      <div class="summary-grid">${cells}</div>`;
  });
}

function exportData(){
  const lines = [];
  lines.push('=== 均線分析工具資料匯出 ===');
  groups.forEach(g=>{
    lines.push('');
    lines.push('【'+g.name+'】');
    g.stocks.forEach(s=>{
      const d = state[s.code];
      lines.push(
        s.code+' '+s.name+' | 日期:'+(d.date||'-')+
        ' | 收盤:'+(d.close||'-')+
        ' | 盤中最高:'+(d.high||'-')+
        ' | MA5:'+(d.ma5||'-')+
        ' | MA10:'+(d.ma10||'-')+
        ' | MA20:'+(d.ma20||'-')+
        ' | MA60:'+(d.ma60||'-')+
        ' | MA120:'+(d.ma120||'-')+
        ' | MA240:'+(d.ma240||'-')
      );
    });
  });
  return lines.join('\n');
}

document.getElementById('exportBtn').addEventListener('click', async ()=>{
  const text = exportData();
  const statusEl = document.getElementById('exportStatus');
  try{
    await navigator.clipboard.writeText(text);
    statusEl.textContent = '已複製!';
  }catch(e){
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position='fixed'; ta.style.opacity='0';
    document.body.appendChild(ta);
    ta.select();
    try{ document.execCommand('copy'); statusEl.textContent = '已複製!'; }
    catch(e2){ statusEl.textContent = '複製失敗,請手動選取'; }
    document.body.removeChild(ta);
  }
  setTimeout(()=>{ statusEl.textContent=''; }, 3000);
});

function groupStats(g){
  let sumPct = 0, periodsCounted = 0, divergeCount = 0;
  MA_PERIODS.forEach(p=>{
    let above=0, total=0;
    g.stocks.forEach(s=>{
      const close = num(state[s.code].close);
      const ma = num(state[s.code]['ma'+p]);
      const r = isAbove(close, ma);
      if(r!==null){ total++; if(r) above++; }
    });
    if(total){
      const pct = above/total*100;
      sumPct += pct; periodsCounted++;
      const benchBelow = benchmarks.some(b=> isAbove(b.close,b.ma[p])===false);
      if(pct>=70 && benchBelow) divergeCount++;
    }
  });
  const avgPct = periodsCounted? sumPct/periodsCounted : null;
  return {avgPct, divergeCount};
}

function renderOverview(){
  const root = document.getElementById('overviewRoot');
  const ranked = groups.map(g=>({name:g.name, ...groupStats(g)}))
    .sort((a,b)=> (b.avgPct??-1) - (a.avgPct??-1));

  const rows = ranked.map((r, i)=>{
    const pct = r.avgPct===null ? 0 : Math.round(r.avgPct);
    const color = pct>=70 ? 'var(--strong)' : pct<=30 ? 'var(--weak)' : 'var(--signal)';
    return `<div class="overview-row">
      <div class="overview-rank">${i+1}</div>
      <div class="overview-name"><a class="overview-link" href="#grp-${r.name}">${r.name}</a></div>
      <div class="overview-barwrap"><div class="overview-bar" style="width:${pct}%; background:${color};"></div></div>
      <div class="overview-pct" style="color:${color};">${r.avgPct===null?'–':pct+'%'}</div>
      ${r.divergeCount>0 ? `<div class="overview-diverge">${r.divergeCount}項強於大盤</div>` : ''}
    </div>`;
  }).join('');

  root.innerHTML = `<div class="overview-card">
    <div class="overview-title">族群總覽 — 依站上均線平均比例排序</div>
    <div class="overview-sub">數值為該族群在6條均線(5/10/20/60/120/240日)上站上比例的平均值,越高代表族群整體多頭排列越完整</div>
    ${rows}
  </div>`;
}

function updateExportHint(){
  const total = groups.reduce((sum, g) => sum + g.stocks.length, 0);
  const el = document.getElementById('exportHint');
  if(el) el.textContent = `按這裡可以把目前畫面上的${total}檔資料複製成一段文字,方便留存或核對。`;
}

renderBenchmarks();
renderOverview();
renderGroups();
updateExportHint();
</script>
</body>
</html>
